generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProspectStatus {
  generated
  analyzed
  approved
  ready
  contacted
  second_attempt
  replied
  followup
  closed
  rejected
  uncontactable
}

model Prospect {
  id               String         @id @default(cuid())
  name             String
  normalizedName   String
  contactName      String         @default("")
  city             String
  languageCode     String         @default("es")
  email            String         @default("")
  normalizedEmail  String         @default("")
  phone            String         @default("")
  normalizedPhone  String         @default("")
  type             String
  website          String         @default("")
  rating           String         @default("")
  userRatingCount  Int?
  websiteFetchFailed Boolean      @default(false)
  websiteLoadTimeMs Int?
  hasWhatsappCta   Boolean?
  hasContactCta    Boolean?
  isMobileFriendly Boolean?
  mapsUrl          String         @default("")
  opportunity      String         @default("")
  recommendedSite  String         @default("")
  pitchAngle       String         @default("")
  segmentIdeal     String         @default("")
  painPoint        String         @default("")
  evidence         Json?
  recommendedOffer String         @default("")
  nextAction       String         @default("")
  owner            String         @default("")
  nextFollowupAt   DateTime?
  fitScore         Int            @default(0)
  urgencyScore     Int            @default(0)
  contactabilityScore Int         @default(0)
  activityScore    Int            @default(0)
  promptVersion    String         @default("")
  responseCategory String         @default("")
  meetingAt        DateTime?
  proposalAt       DateTime?
  closedAt         DateTime?
  revenue          Float?
  subject          String         @default("")
  message          String         @default("")
  status           ProspectStatus @default(generated)
  source           String         @default("google-places")
  contacted        Boolean        @default(false)
  hotLead          Boolean        @default(false)
  scheduledSendAt  DateTime?
  lastContactedAt  DateTime?
  followupCount    Int            @default(0)
  followupStage    Int            @default(0)
  createdAt        DateTime       @default(now())
  lastCheckedAt    DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  businessStatus   String         @default("")
  primaryType      String         @default("")
  formattedAddress String         @default("")
  lastError        String         @default("")
  lastMessageId    String         @default("")
  runId            String?
  crawlSiteRunId   String         @default("")
  run              Run?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  contactEvents    ContactEvent[]
  crawlHistory     ProspectCrawl[]
  researches       ProspectResearch[]

  @@index([status, createdAt])
  @@index([runId])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([normalizedName])
}

model ContactEvent {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  eventType  String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
}

model Run {
  id                   String     @id @default(cuid())
  source               String
  searchesCount        Int
  placesFound          Int
  duplicatesFiltered   Int
  emailsFound          Int
  prospectsSaved       Int
  googlePlacesRequests Int
  websiteFetches       Int
  status               String     @default("completed")
  error                String?
  createdAt            DateTime   @default(now())
  prospects            Prospect[]

  @@index([createdAt])
}

model ProspectCrawl {
  id               String   @id @default(cuid())
  prospectId       String
  prospect         Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  ownerUsername    String   @default("")
  crawlOwnerUserId String   @default("")
  siteUrl          String
  crawlSiteRunId   String   @default("")
  projectId        String   @default("")
  status           String   @default("pending")
  attemptCount     Int      @default(1)
  error            String   @default("")
  summary          Json?
  pdfFilename      String   @default("")
  pdfData          Bytes?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([crawlSiteRunId])
  @@index([status, createdAt])
}

model ProspectResearch {
  id            String   @id @default(cuid())
  prospectId    String
  prospect      Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  status        String   @default("running")
  sourceResults Json?
  error         String  @default("")
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  findings      ProspectResearchFinding[]

  @@index([prospectId, createdAt])
  @@index([status, createdAt])
}

model ProspectResearchFinding {
  id              String           @id @default(cuid())
  researchId      String
  research        ProspectResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  field           String
  currentValue    String            @default("null")
  proposedValue   String
  sourceName      String
  sourceUrl       String
  confidence      String
  confidenceReason String
  status          String            @default("pending")
  decision        String            @default("")
  decidedBy       String            @default("")
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())

  @@index([researchId, status])
  @@index([field, createdAt])
}

model DashboardCredential {
  id           Int      @id @default(1)
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
